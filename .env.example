# PostgreSQL
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_pass@localhost:5432/sentinel_db
DATABASE_URL_SYNC=postgresql://sentinel:sentinel_pass@localhost:5432/sentinel_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=sentinel-consumers

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# ML Model
ONNX_MODEL_PATH=./models/sentinel_lgbm.onnx

# Security
HMAC_SECRET_KEY=change-me-in-production
